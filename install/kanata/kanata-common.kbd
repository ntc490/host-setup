;; Shared home-row mods. Machine-independent: every host's config (include)s
;; this file and supplies only its own (defcfg ...) with the right linux-dev
;; input device. Edit the mods here once and every machine picks them up.
;;
;; NOTE: no (defcfg) here on purpose -- each per-machine file owns that, since
;; linux-dev (which keyboard kanata grabs) is the only thing that varies.

(defsrc
  caps a s d f j k l ;
)

(defvar
  tap-time 150
  hold-time 200
)

(defalias
  ;; Removed f24 multi - this often causes issues
  a (tap-hold $tap-time $hold-time a lmet)
  s (tap-hold $tap-time $hold-time s lalt)
  d (tap-hold $tap-time $hold-time d lsft)
  f (tap-hold $tap-time $hold-time f lctl)
  j (tap-hold $tap-time $hold-time j rctl)
  k (tap-hold $tap-time $hold-time k rsft)
  l (tap-hold $tap-time $hold-time l ralt)
  ; (tap-hold $tap-time $hold-time ; rmet)
)

(deflayer base
  tab @a @s @d @f @j @k @l @;
)
