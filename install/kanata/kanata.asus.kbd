;; ASUS X202EV. linux-dev pins kanata to the built-in keyboard so an external
;; keyboard is left untouched. The home-row mods live in kanata-common.kbd.
;; (Same i8042 device path as the X1 Carbon -- both are PS/2 internal keyboards.)
(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  linux-dev /dev/input/by-path/platform-i8042-serio-0-event-kbd
)

(include "kanata-common.kbd")
